# ════════════════════════════════════════════════════════════════════════════
#  HomeCare OS — Environment Variable Template
#  Copy this file to .env, fill in real values, then: chmod 600 .env
#  NEVER commit .env to git.
# ════════════════════════════════════════════════════════════════════════════

# ── Django core ───────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_generate_with_python_command_above

DEBUG=False

# Comma-separated list of allowed host/domain names
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Password for the 'homecare' Postgres user
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# Full connection URL — sslmode=require enforces SSL on every connection
DATABASE_URL=postgresql://homecare:CHANGE_ME_strong_random_password@db:5432/homecare?sslmode=require

# ── Field-level Encryption ────────────────────────────────────────────────────
# Fernet symmetric key — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key safe — losing it means encrypted patient data is unrecoverable.
FIELD_ENCRYPTION_KEY=CHANGE_ME_generate_with_fernet

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Backups (GPG symmetric passphrase for nightly pg_dump encryption) ─────────
# Used by scripts/backup_db.sh — keep this separate from FIELD_ENCRYPTION_KEY
GPG_PASSPHRASE=CHANGE_ME_strong_gpg_passphrase

# ── Backup directory on VPS (absolute path) ───────────────────────────────────
BACKUP_DIR=/var/backups/homecareos
